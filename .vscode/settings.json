{
  "rust-analyzer.linkedProjects": [
    "./raw-traversal/Cargo.toml",
    "./many-spans/many-spans/Cargo.toml",
    "./many-spans/many-spans-macros/Cargo.toml",
    "./Cargo.toml",
    "./arm7/Cargo.toml",
    "./arm9/Cargo.toml"
  ],
  "rust-analyzer.check.allTargets": false,
  "editor.colorDecorators": false,
  "runOnSave.commands": [
    {
      "match": "^(?!.*/(xtask|target)/).*\\.(rs|s)$",
      "command": "cd ${workspaceFolder} && cargo -q xtask corpus --resolve-completed-symbols --style columns,compact --labels before --stub-mode position-with-warn",
      "runIn": "backend",
      "runningStatusMessage": "Running corpus sync...",
      "finishStatusMessage": "Done.",
      "doNotDisturb": true
    }
  ]
}