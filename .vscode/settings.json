{
  "rust-analyzer.linkedProjects": [
    "./Cargo.toml",
    "./arm7/Cargo.toml",
    "./arm9/Cargo.toml",
    "./shared/Cargo.toml"
  ],
  "rust-analyzer.check.allTargets": false,
  "editor.colorDecorators": false,
  "runOnSave.commands": [
    {
      "match": "^(?!.*/(xtask|target)/).*\\.(rs|s)$",
      "command": "cd ${workspaceFolder} && cargo -q xtask corpus --style columns,compact,align --labels before",
      "runIn": "backend",
      "runningStatusMessage": "Running corpus sync...",
      "finishStatusMessage": "Done."
    }
  ]
}